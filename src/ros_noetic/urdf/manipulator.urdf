<?xml version="1.0"?>
<robot name="manipulator">

    <!-- Colors -->
    <material name="purple">
        <color rgba="0.275 0.11 0.49 1.0"/>
    </material>
    <material name="gold">
        <color rgba="0.99 0.81 0.14 1.0"/>
    </material>
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>
    <material name="red">
        <color rgba="0.8 0 0 1.0"/>
    </material>
    <material name="green">
        <color rgba="0 1.0 0 1.0"/>
    </material>
    <material name="blue">
        <color rgba="0 0 0.8 1.0"/>
    </material>

    <!-- Base Link of Robot -->
    <!-- Origin at -0.05, placed to have original plane not affect the paper parameters -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 -0.05" rpy="0 0 0"/>
            <geometry>
                <box size="1.0 1.0 0.1"/>
            </geometry>
            <material name="white"/>
        </visual>
            <visual>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <geometry>
                <box size="0.06 0.06 0.02"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <visual>
            <origin xyz="0 0 0.005" rpy="0 0 0"/>
            <geometry>
                <box size="0.09 0.09 0.01"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <!--Revolute Joint connecting link 1 driven by joint 1 to base_link-->
    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.1416" upper="3.1416" effort="10" velocity="1"/>
    </joint>

    <link name="link1">
        <visual>
            <origin xyz="0 0 0.065" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.02" length="0.13"/>
            </geometry>
            <material name="gold"/>
        </visual>
        <visual>
            <origin xyz="0.01 0 0.1" rpy="0 0 0"/>
            <geometry>
                <box size="0.06 0.04 0.02"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="0.02 0 0.12" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1"/>
    </joint>
    
    <link name="link2">     
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.02" length="0.02"/>
            </geometry>
            <material name="gold"/>
        </visual>
        <visual>
            <origin xyz="0.045 0 -0.002" rpy="0 0 0"/>
            <geometry>
                <box size="0.09 0.035 0.016"/>
            </geometry>
            <material name="red"/>
        </visual>
        <visual>
            <origin xyz="0.01 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.04 0.02"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>


    <joint name="joint3" type="revolute">
        <parent link="link2"/>
        <child link="link3"/>
        <origin xyz="0.09 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1"/>
    </joint>

   <link name="link3">     
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.02" length="0.02"/>
            </geometry>
            <material name="gold"/>
        </visual>
        <visual>
            <origin xyz="0.04 0 -0.002" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.035 0.016"/>
            </geometry>
            <material name="green"/>
        </visual>
        <visual>
            <origin xyz="0.01 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.04 0.02"/>
            </geometry>
            <material name="green"/>
        </visual>
    </link>

    <joint name="joint4" type="revolute">
        <parent link="link3"/>
        <child link="link4"/>
        <origin xyz="0.08 0 0" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1"/>
    </joint>

    <link name="link4">     
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.01" length="0.04"/>
            </geometry>
            <material name="gold"/>
        </visual>
        <visual>
            <origin xyz="-0.01 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <box size="0.02 0.04 0.02"/>
            </geometry>
            <material name="purple"/>
        </visual>
        <visual>
            <origin xyz="0.04 0 0.0" rpy="1.5708 0 0"/>
            <geometry>
                <box size="0.06 0.035 0.01"/>
            </geometry>
            <material name="purple"/>
        </visual>
        <visual>
            <origin xyz="0.07 0 0.0" rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.0175" length="0.01"/>
            </geometry>
            <material name="purple"/>
        </visual>
        <visual>
            <origin xyz="0.06 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <material name="gold"/>
        </visual>
    </link>

    <joint name="joint5" type="prismatic">
        <parent link="link4"/>
        <child link="link5"/>
        <origin xyz="0.06 0 0" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.00" upper="0.06" effort="10" velocity="0.2"/>
    </joint>

    <link name="link5">     
        <visual>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.006" length="0.08"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

</robot>